# ─── ONYX WEB — environment variables ───────────────────────────────────────
# Zkopíruj do `.env` (lokálně) nebo nastav jako Variables v hostingu (Railway).
# NIKDY necommituj reálný .env. Tady jsou jen placeholdery.

# ── Běh ──
NODE_ENV=production
PORT=3000

# ── Databáze (MySQL) ──
# Railway/PlanetScale/jiný MySQL. Po nastavení spusť: npm run db:push
DATABASE_URL=mysql://user:password@host:3306/onyxweb

# ── Auth ──
JWT_SECRET=vygeneruj-dlouhy-nahodny-retezec
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# ── Doručení leadů majiteli (KRITICKÉ pro prodej) ──
# Bez tohoto ti poptávky z webu NEPŘIJDOU, když běžíš mimo Manus.
# Bot: napiš @BotFather → /newbot → zkopíruj token.
# Chat ID: napiš svému botovi zprávu, pak otevři
#   https://api.telegram.org/bot<TOKEN>/getUpdates a najdi "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Platby (Stripe) — až u placených objednávek ──
STRIPE_SECRET_KEY=

# ── Manus runtime (jen když běžíš na Manusu; jinak nech prázdné) ──
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ── Frontend (build-time, VITE_*) ──
VITE_APP_ID=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
VITE_OAUTH_PORTAL_URL=

# ── OPTIHUB / OMNI TOOL FABRIC (default OFF) ──
OPTIHUB_TOOL_FABRIC_ENABLED=false
OPTIHUB_TOOL_FIRECRAWL_ENABLED=false
OPTIHUB_TOOL_BRAVE_SEARCH_ENABLED=false
OPTIHUB_TOOL_STRIPE_ENABLED=false
OPTIHUB_TOOL_FIGMA_ENABLED=false
OPTIHUB_TOOL_NOTION_ENABLED=false
OPTIHUB_TOOL_MEM0_ENABLED=false
OPTIHUB_TOOL_COMPOSIO_ENABLED=false
OPTIHUB_TOOL_PLAYWRIGHT_ENABLED=false
OPTIHUB_TOOL_E2B_ENABLED=false

FIRECRAWL_API_KEY=
BRAVE_API_KEY=
MEM0_API_KEY=
COMPOSIO_API_KEY=
E2B_API_KEY=

# OAuth-backed providers require an approved token handoff.
OPTIHUB_TOOL_FIGMA_AUTH_READY=false
OPTIHUB_TOOL_NOTION_AUTH_READY=false
OPTIHUB_TOOL_FIGMA_BEARER_TOKEN=
OPTIHUB_TOOL_NOTION_BEARER_TOKEN=

# Internal sidecars; never expose them publicly.
OPTIHUB_BRAVE_MCP_URL=
OPTIHUB_PLAYWRIGHT_MCP_URL=
